#version 330 core

// Vertex shader: passa cada vértice para o mundo (matriz de modelo) e para o ecrã (vista e projeção).
// Também gera o céu sem vértices e trata das luzes desenhadas como pontos.

// Dados de cada vértice: posição, normal, cor difusa (Kd) e coordenadas de textura.
layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace;
layout(location = 2) in vec3 vertexColor;
layout(location = 3) in vec2 vertexUV;

// Saídas: interpoladas para cada fragmento.
out vec3 position_worldspace;
out vec3 normal_worldspace;
out vec3 fragmentColor;
out vec2 UV;

uniform mat4 Model, View, Projection;  // matrizes de modelo, vista e projeção
uniform int mode;      // 0 objeto, 1 terreno, 2 mar, 3 céu, 4 luzes da pista
uniform vec3 eyePos;  // posição da câmara
uniform float time;   // tempo (s), para o flash piscar

void main() {
    if (mode == 3) {  // céu: um triângulo que cobre o ecrã todo, gerado sem vértices, ao fundo
        vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2) * 2.0 - 1.0;
        position_worldspace = vec3(p, 0.0);
        gl_Position = vec4(p, 0.9999, 1.0);
        return;
    }
    vec4 world = Model * vec4(vertexPosition_modelspace, 1.0);
    position_worldspace = world.xyz;
    // as normais rodam com a inversa transposta da matriz de modelo (continuam perpendiculares)
    normal_worldspace = mat3(transpose(inverse(Model))) * vertexNormal_modelspace;
    fragmentColor = vertexColor;
    UV = vertexUV;
    gl_Position = Projection * View * world;

    if (mode == 4) {  // luzes: pontos que diminuem com a distância
        float distance = length(eyePos - world.xyz);
        gl_PointSize = clamp(5000.0 / distance, 3.0, 12.0);
        // flash da cauda do avião: a normal.y marca as luzes que piscam
        if (vertexNormal_modelspace.y > 0.0 && fract(time * 1.2) > 0.12) gl_Position = vec4(2.0, 2.0, 2.0, 1.0);  // fora do ecrã
        // PAPI: a normal guarda o ângulo da luz; acima dele vê-se branco, abaixo vermelho
        if (vertexNormal_modelspace.x > 0.0)
            fragmentColor = degrees(asin((eyePos.y - world.y) / distance)) > vertexNormal_modelspace.x ? vec3(1.0) : vec3(1.0, 0.05, 0.05);
    }
}
