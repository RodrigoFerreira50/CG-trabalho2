#version 330 core

// Phong por fragmento com uma luz pontual (sol de dia, lua de noite). De noite junta-se uma segunda
// luz pontual em cone: o farol de aterragem do avião.

in vec3 position_worldspace;
in vec3 normal_worldspace;
in vec3 fragmentColor;
in vec2 UV;

out vec4 color;

uniform int mode;          // 0 objeto, 1 terreno, 2 mar, 3 céu, 4 luzes da pista
uniform bool night, useTexture;
uniform vec2 specular;     // (Ks, Ns) do material
uniform float time;
uniform vec3 lightPos, eyePos, spotPos, spotDir, satU, satV;
uniform mat4 invSky;       // píxel do ecrã -> direção no mundo
uniform sampler2D textureSampler, satellite;
uniform samplerCube skybox;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

void main() {
    vec3 P = position_worldspace;
    vec3 fog = night ? vec3(0.015, 0.02, 0.045) : vec3(0.74, 0.82, 0.92);
    vec3 lightColor = night ? vec3(0.18, 0.2, 0.32) : vec3(1.0, 0.96, 0.88);
    vec3 toLight = normalize(lightPos - eyePos);

    if (mode == 3) {  // céu: skybox, sol / lua e, de noite, estrelas
        vec4 d = invSky * vec4(P.xy, 1.0, 1.0);
        vec3 dir = normalize(d.xyz / d.w);
        vec3 sky = mix(fog, texture(skybox, dir).rgb * (night ? 0.05 : 1.0), smoothstep(0.0, 0.12, dir.y));
        float s = max(dot(dir, toLight), 0.0);
        if (night) {
            vec2 cell = floor(vec2(atan(dir.z, dir.x), asin(dir.y)) * 300.0);
            sky += vec3(step(0.997, hash(cell)) * hash(cell + 7.0)) * smoothstep(0.02, 0.2, dir.y);
            sky += vec3(0.85, 0.88, 1.0) * (smoothstep(0.9996, 0.99975, s) + 0.15 * pow(s, 60.0));
        } else {
            sky += vec3(1.0, 0.9, 0.7) * 4.0 * pow(s, 600.0);
        }
        color = vec4(sky, 1.0);
        return;
    }
    float distance = length(eyePos - P), fogFactor = exp(-pow(distance / (night ? 18000.0 : 28000.0), 2.0));
    if (mode == 4) {  // luzes da pista: discos que brilham sozinhos
        if (length(gl_PointCoord - 0.5) > 0.5) discard;
        color = vec4(mix(fog, fragmentColor, max(fogFactor, 0.4)), 1.0);
        return;
    }

    vec3 N = normalize(normal_worldspace), V = normalize(eyePos - P), albedo = fragmentColor;
    vec2 spec = specular;
    if (dot(N, V) < 0.0) N = -N;  // iluminação dos dois lados
    if (useTexture) albedo *= texture(textureSampler, vec2(UV.x, 1.0 - UV.y)).rgb;
    if (mode == 1) {  // terreno: cor da imagem de satélite, colocada pela posição no mundo
        vec2 st = vec2(dot(satU, vec3(P.xz, 1.0)), dot(satV, vec3(P.xz, 1.0)));
        if (st == clamp(st, 0.0, 1.0)) albedo = pow(texture(satellite, st).rgb, vec3(0.8)) * 1.25;
    }
    if (mode == 2) {  // mar: ondas pequenas, só perto da câmara
        float wave = 0.03 * clamp(1.0 - distance / 2500.0, 0.0, 1.0);
        N = normalize(vec3(wave * sin(P.x * 0.05 + P.z * 0.03 + time * 1.3), 1.0, wave * cos(P.z * 0.06 + P.x * 0.02 + time)));
    }

    // Phong: ambiente (mais do céu do que do chão) + difusa (N.L) + especular ((R.V)^Ns)
    vec3 L = normalize(lightPos - P);
    float diffuse = max(dot(N, L), 0.0);
    float shine = diffuse > 0.0 ? pow(max(dot(reflect(-L, N), V), 0.0), spec.y) : 0.0;
    vec3 result = albedo * ((night ? 0.08 : 0.4) * (0.75 + 0.35 * N.y) + diffuse * lightColor) + spec.x * shine * lightColor;

    if (night) {
        // farol de aterragem: luz pontual em cone, que enfraquece com a distância
        vec3 Ls = spotPos - P;
        float d = length(Ls);
        Ls /= d;
        float spot = smoothstep(0.94, 0.985, dot(-Ls, spotDir)) * 6.0 / (1.0 + d * d / 9000.0);
        float diffuseSpot = max(dot(N, Ls), 0.0);
        result += spot * (albedo * diffuseSpot + spec.x * (diffuseSpot > 0.0 ? pow(max(dot(reflect(-Ls, N), V), 0.0), spec.y) : 0.0)) * vec3(1.0, 0.95, 0.85);
        // luzes das casas: onde o satélite mostra telhados (avermelhados), algumas janelas acesas
        vec2 cell = floor(P.xz / 30.0), offset = fract(P.xz / 30.0) - 0.2 - 0.6 * vec2(hash(cell + 1.3), hash(cell + 5.1));
        if (mode == 1 && albedo.r > albedo.g + 0.03)
            result += vec3(1.0, 0.7, 0.35) * step(0.8, hash(cell)) * smoothstep(0.06 + distance / 30000.0, 0.0, length(offset));
    }
    if (mode == 2) {  // reflexo do céu com Fresnel (Schlick)
        vec3 R = reflect(-V, N);
        R.y = abs(R.y);
        float fresnel = 0.04 + 0.96 * pow(1.0 - max(dot(N, V), 0.0), 5.0);
        result = mix(result, texture(skybox, R).rgb * (night ? 0.05 : 1.0), 0.25 + 0.75 * fresnel) + spec.x * shine * lightColor;
    }
    color = vec4(mix(fog, result, fogFactor), 1.0);  // neblina
}
